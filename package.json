{
  "name": "delegated-authority-threat-model",
  "version": "0.0.1",
  "description": "Delegated Authority Threat Model (DIF TAAWG)",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentralized-identity/delegated-authority-threat-model.git"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:cert": "node ./scripts/dev-cert.mjs",
    "dev:dns": "node ./scripts/dev-dns.mjs",
    "edit": "vite build --watch",
    "refs": "node ./scripts/fetch-spec-refs.js",
    "preview": "vite preview --outDir . --host localhost --port 4173",
    "render": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "spec",
    "specs",
    "markdown",
    "editor",
    "standards"
  ],
  "author": "DIF Trusted AI Agents Working Group",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/decentralized-identity/delegated-authority-threat-model/issues"
  },
  "homepage": "https://identity.foundation/delegated-authority-threat-model",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.1.0",
    "@floating-ui/dom": "^1.7.6",
    "@lit/react": "^1.0.8",
    "@shoelace-style/animations": "^1.2.0",
    "@shoelace-style/localize": "^3.2.1",
    "@vscode/markdown-it-katex": "1.1.2",
    "chart.js": "^4.5.1",
    "chokidar": "4.0.3",
    "composed-offset-position": "^0.0.6",
    "jsdom": "26.1.0",
    "katex": "0.16.22",
    "lit": "^3.3.2",
    "markdown-it": "^14.2.0",
    "markdown-it-attrs": "4.3.1",
    "markdown-it-chart": "^0.2.0",
    "markdown-it-container": "^2.0.0",
    "markdown-it-deflist": "^2.1.0",
    "markdown-it-icons": "^0.4.1",
    "markdown-it-ins": "^2.0.0",
    "markdown-it-mark": "^2.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-prism": "^2.3.1",
    "markdown-it-references": "1.0.0-alpha.10",
    "markdown-it-sub": "^1.0.0",
    "markdown-it-sup": "^1.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-textual-uml": "0.1.3",
    "mermaid": "11.15.0",
    "prismjs": "1.30.0",
    "qr-creator": "^1.0.0",
    "style-observer": "^0.1.2"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  }
}
